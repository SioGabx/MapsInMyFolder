[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	ignorecase = true
[submodule]
	active = .
[remote "origin"]
	url = https://github.com/SioGabx/MapsInMyFolder
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "redev"]
	remote = origin
	merge = refs/heads/redev
